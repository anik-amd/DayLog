{
    "name": "DayLog",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/sshd:1": {
            "version": "latest"
        }
    },
    "onCreateCommand": "bash .devcontainer/setup-android.sh",
    "containerEnv": {
        "ANDROID_HOME": "/usr/local/lib/android/sdk",
        "ANDROID_SDK_ROOT": "/usr/local/lib/android/sdk",
        "GRADLE_USER_HOME": "/home/vscode/.gradle"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "jetbrains.kotlin",
                "vscjava.vscode-gradle"
            ],
            "settings": {
                "gradle.configuration-cache": "on",
                "files.exclude": {
                    "**/.gradle": true,
                    "**/build": true
                }
            }
        }
    },
    "hostRequirements": {
        "storage": "32gb"
    }
}
